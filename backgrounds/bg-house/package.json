{
  "name": "bg-house-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "BG House (After Effects compCode) dikonversi ke komponen Remotion + library part",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts BGHouse out/bg-house.png --frame=0",
    "render": "remotion render src/index.ts BGHouse out/bg-house.mp4",
    "typecheck": "tsc --noEmit",
    "convert": "node tools/extract.cjs && node tools/generate.cjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
